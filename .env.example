NODE_ENV=development
PORT=3000
# Comma-separated browser origins. Blank allows only requests without an Origin header.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set only for a known reverse proxy deployment; 0 for direct connections.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=120000
RATE_LIMIT_MAX=200
LOG_LEVEL=info
LOG_TO_FILE=false

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/express_frame?schema=public"
